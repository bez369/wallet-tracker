# Helius API key (free tier is plenty for one wallet) — https://dev.helius.xyz
HELIUS_API_KEY=65e7901e-3c94-47ac-a9fb-b1225c4940ba

# The trader wallet you're tracking
TARGET_WALLET=CkUZV387xnoGpF7wC2moMa6mPmAgCvTT4pWgzq4M9fCD

# Any Solana RPC URL. If you have a Helius RPC endpoint, use that — it doubles
# as your general RPC and saves you from juggling two providers.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=65e7901e-3c94-47ac-a9fb-b1225c4940ba

# How often to poll for new transactions, in ms
POLL_INTERVAL_MS=15000

# How many enhanced transactions to pull per Helius page (max 100)
PAGE_SIZE=100

# Where to write the CSV
CSV_PATH=./data/entries.csv

# Where to persist the "last processed signature" + per-mint buy/sell history
STATE_PATH=./state/state.json

# Max Helius getTokenAccounts pages to walk when estimating holder count
# (each page ~1000 accounts). 0 disables holder-count lookups entirely.
HOLDER_LOOKUP_MAX_PAGES=3

# Comma-separated Helius tx "source" values to treat as pump.fun-related.
# PUMP_FUN = bonding curve, PUMP_AMM = pump's own post-migration AMM.
# Add RAYDIUM if you also want to catch him trading migrated tokens there.
RELEVANT_SOURCES=PUMP_FUN,PUMP_AMM

# BUY decision clustering. Each signature remains its own CSV row.
ENTRY_CLUSTER_GAP_SEC=5
ENTRY_CLUSTER_MAX_SPAN_SEC=20
